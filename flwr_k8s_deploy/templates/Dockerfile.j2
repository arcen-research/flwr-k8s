# Multi-architecture Dockerfile for Flower Client
# Supports x86_64 (Linux PC) and ARM64 (Raspberry Pi)

FROM python:3.11-slim-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml ./
COPY {{ package_name }}/ ./{{ package_name }}/

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Create directory for model and data storage
RUN mkdir -p /app/models /root/.cache/cifar10

# Pre-download CIFAR-10 dataset to avoid runtime download issues
# This caches the dataset in the Docker image
RUN python3 -c "from torchvision import datasets; datasets.CIFAR10(root='/root/.cache/cifar10', train=True, download=True); datasets.CIFAR10(root='/root/.cache/cifar10', train=False, download=True)"

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Default command runs the Flower SuperNode
CMD ["flower-supernode", "--insecure"]
